# ============================================================
# Qubit One — environment variable template
#
# Copy this file to `.env` and fill in real values.
# NEVER commit `.env` or any file containing real credentials.
# In production, inject secrets via your platform's secret store
# (e.g. GitHub Actions Secrets, container orchestration secrets).
# ============================================================

# ------------------------------------------------------------
# Database
# ------------------------------------------------------------
# Prisma connection URL. Qubit One ships with the SQLite provider
# (see prisma/schema.prisma). The runtime database file lives in
# /db and is git-ignored. Initialize it with: bun run db:push
DATABASE_URL=

# ------------------------------------------------------------
# Application (reserved for deployment-specific configuration)
# ------------------------------------------------------------
# Public base URL of the deployment, when reverse-proxying behind
# the bundled Caddy gateway or any other reverse proxy.
# APP_URL=
