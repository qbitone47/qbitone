# ============================================================
# Qubit One — environment variable template
#
# Copy this file to `.env` and fill in real values.
# NEVER commit `.env` or any file containing real credentials.
# In production, inject secrets via your platform's secret store
# (e.g. GitHub Actions Secrets, container orchestration secrets).
# ============================================================

# ------------------------------------------------------------
# Database
# ------------------------------------------------------------
# Prisma connection URL. Qubit One uses the PostgreSQL provider
# (see prisma/schema.prisma). In production this is the Supabase
# PostgreSQL connection string (server-only — never expose it to
# the browser). Initialize the schema with: bun run db:push
DATABASE_URL=

# ------------------------------------------------------------
# Authentication
# ------------------------------------------------------------
# HMAC session-signing secret. Required in serverless/production
# deployments (>= 32 chars); generate with: openssl rand -hex 32
# Without it the server falls back to a locally generated secret
# file, which is not reliable on ephemeral filesystems.
# QUBIT_AUTH_SECRET=

# ------------------------------------------------------------
# Application (reserved for deployment-specific configuration)
# ------------------------------------------------------------
# Public base URL of the deployment, when reverse-proxying behind
# the bundled Caddy gateway or any other reverse proxy.
# APP_URL=
