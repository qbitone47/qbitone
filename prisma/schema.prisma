// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Phase 25 · Enterprise Observability — unified telemetry store.
// One bounded, indexed table for REAL server/client telemetry:
// request metering, structured application logs, server errors,
// probe results and client events (vitals / JS errors / route
// transitions / client-observed requests). Values are redacted at
// the source; retention is enforced (see telemetry-server.ts).
model TelemetryEvent {
  id          String    @id @default(cuid())
  ts          DateTime  @default(now())
  kind        String // request | log | error | probe | client-vital | client-error | client-route | client-request
  level       String    @default("info") // debug | info | warn | error
  service     String    @default("qubit-one")
  environment String    @default("runtime")
  requestId   String?
  traceId     String?
  route       String?
  method      String?
  status      Int?
  durationMs  Float?
  actorId     String? // role label only — never PII
  errorCode   String?
  message     String? // redacted, length-capped
  context     String? // redacted JSON, size-capped
  release     String? // commit SHA — change intelligence
  source      String    @default("server") // server | client
  screen      String? // client screen name (client events)

  @@index([ts])
  @@index([kind, ts])
  @@index([route, ts])
  @@index([requestId])
}